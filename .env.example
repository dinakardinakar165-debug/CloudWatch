# CloudWatch Sentinel Environment Variables
# Note: In development and production, never commit actual secrets.

# AWS Account Configuration (Server-Side)
AWS_DEFAULT_REGION=us-east-1
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/CloudWatchSentinelRole
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Supabase PostgreSQL & Realtime
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=

# Render Backend API Proxy
VITE_API_BASE_URL=http://localhost:8000
